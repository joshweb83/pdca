# Application
NODE_ENV=development
PORT=4000
APP_NAME=PDCA
APP_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://pdca_user:pdca_password@localhost:5432/pdca?schema=public"

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# API Keys (for external systems)
API_KEY_SALT=your-api-key-salt

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# External System Integration
# Academic System
ACADEMIC_SYSTEM_URL=https://academic-system.university.edu
ACADEMIC_SYSTEM_API_KEY=academic_api_key_here
ACADEMIC_SYSTEM_TIMEOUT=30000

# HR System
HR_SYSTEM_URL=https://hr-system.university.edu
HR_SYSTEM_API_KEY=hr_api_key_here
HR_SYSTEM_TIMEOUT=30000

# Finance System
FINANCE_SYSTEM_URL=https://finance-system.university.edu
FINANCE_SYSTEM_API_KEY=finance_api_key_here
FINANCE_SYSTEM_TIMEOUT=30000

# Integration Settings
INTEGRATION_RETRY_ATTEMPTS=3
INTEGRATION_RETRY_DELAY=1000
INTEGRATION_CIRCUIT_BREAKER_THRESHOLD=5
INTEGRATION_CIRCUIT_BREAKER_TIMEOUT=60000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@pdca.university.edu

# Webhook
WEBHOOK_SECRET=your-webhook-secret-for-verification

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
